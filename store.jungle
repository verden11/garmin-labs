# Release build: no Fit permission, no Connect sync (ADR-033), no (:debug)
# test hooks even without -r (ADR-034), and the
# resources-store overlay hides dev-only menu entries (ADR-008).
project.manifest = manifest-store.xml
base.sourcePath = source
base.resourcePath = resources;resources-store
base.excludeAnnotations = sync;debug

# The complications resource only compiles for products that have the API
# (CIQ 4.2+); older products (ADR-038) build without it and simply never
# publish (ADR-044).
