# Free build: Two Suns, the free app (manifest.free.xml, its own app id). Excludes every (:pro)-annotated
# symbol; docs/decisions.md ADR-020 (Free + Pro ladder). resources-free holds what only Free has: AppName and the Free settings
# and properties (Accent only). The shared resources/ has NO settings files, so two never overlap.
project.manifest = manifest.free.xml
base.sourcePath = source
base.resourcePath = resources;resources-free;resources-accent-free
# Rectangle code (TwoSunsTrack, TwoSunsRectFit, TwoSunsRectSpread: `rect`) stays on every round and rectangle product; its `norect` twins go.
base.excludeAnnotations = pro;mono;norect
# AppName is the one string that differs by tier, and a language does NOT inherit the default's strings
# (the compiler warns "String id 'AppName' undefined for language ..."). So each language also searches the tier
# folder; AppName is defined only there, never in resources/ or resources-<lang>/, so no language can override it.
base.lang.dan = $(base.lang.dan);resources-free
base.lang.deu = $(base.lang.deu);resources-free
base.lang.dut = $(base.lang.dut);resources-free
base.lang.fin = $(base.lang.fin);resources-free
base.lang.fre = $(base.lang.fre);resources-free
base.lang.ita = $(base.lang.ita);resources-free
base.lang.lit = $(base.lang.lit);resources-free
base.lang.nob = $(base.lang.nob);resources-free
base.lang.pol = $(base.lang.pol);resources-free
base.lang.por = $(base.lang.por);resources-free
base.lang.spa = $(base.lang.spa);resources-free
base.lang.swe = $(base.lang.swe);resources-free
base.lang.tur = $(base.lang.tur);resources-free
base.lang.ukr = $(base.lang.ukr);resources-free

# The Instinct E and 3 Solar (docs/decisions.md ADR-024): the black-and-white palette (`color` excluded) and no Accent or
# Golden settings file (their folders are left out of the resourcePath: a 1-bit display shows neither). A per-product
# excludeAnnotations REPLACES the base list, so the tier's own exclude is restated. An Instinct never draws a rectangle, so it
# also drops the `rect` code (it raised Instinct Pro from 44.4 to 50.0 kB of 59.8 kB and ran it out of memory, 2026-10-10) and keeps the `norect` twins.
instincte40mm.excludeAnnotations = pro;color;rect
instincte40mm.resourcePath = resources;resources-free
instincte45mm.excludeAnnotations = pro;color;rect
instincte45mm.resourcePath = resources;resources-free
instinct3solar45mm.excludeAnnotations = pro;color;rect
instinct3solar45mm.resourcePath = resources;resources-free
