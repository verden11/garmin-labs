<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- The line at the bottom. $1$ is a time (Sunrise 6:41) or a duration (3:42 of daylight). Sentences the wearer reads, so keep them short. -->
    <string id="sky_daylight_left">$1$ of daylight</string>
    <string id="sky_sun_up">Sun is up</string>
    <string id="sky_sunrise">Sunrise $1$</string>
    <string id="sky_sunrise_estimate">Sunrise ~$1$</string>
    <string id="sky_sunset">Sunset $1$</string>
    <string id="sky_midnight_sun">Sun stays up today</string>
    <string id="sky_polar_night">Sun stays down today</string>
    <string id="sky_no_sunrise">No sunrise tomorrow</string>
    <!-- Shorter wordings for a narrow row: the same information, fewer characters. -->
    <string id="sky_daylight_left_short">$1$ light</string>
    <string id="sky_sunrise_short">Rise $1$</string>
    <string id="sky_sunrise_estimate_short">Rise ~$1$</string>
    <string id="sky_sunset_short">Set $1$</string>
    <string id="sky_midnight_sun_short">Sun stays up</string>
    <string id="sky_polar_night_short">Sun stays down</string>
    <string id="sky_no_sunrise_short">No sunrise</string>
    <string id="sky_midnight_sun_min">No sunset</string>
    <string id="sky_polar_night_min">No sunrise</string>
    <string id="sky_no_place">No place yet</string>
    <string id="sky_no_data">No sun data</string>
    <!-- Shown where a value is missing. -->
