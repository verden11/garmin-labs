<strings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">

    <!-- The unit letters of the daylight sentence, "3h 42m of daylight" (ROADMAP 13.17). English only for now: every language
         falls back to these, so a resources-<lang>/strings/units.xml would override them (whether to translate them is ROADMAP 13.7,
         shared with Days To Go). Kept out of strings.xml so tools/check_strings.py does not require them in every language. -->
    <string id="unit_hours">h</string>
    <string id="unit_minutes">m</string>
</strings>
