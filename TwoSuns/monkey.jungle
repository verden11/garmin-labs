# Pro build: the paid app, the live app id in manifest.xml (named "Two Suns Pro"). Excludes every (:free)-annotated
# symbol; docs/decisions.md ADR-020 (Free + Pro ladder). resources-pro holds what only Pro has: AppName and the full settings
# and properties (Accent, Orientation, Golden, Curve, Date). The shared resources/ has NO settings files, so two never overlap.
project.manifest = manifest.xml
base.sourcePath = source
base.resourcePath = resources;resources-pro
base.excludeAnnotations = free
# AppName is the one string that differs by tier, and a language does NOT inherit the default's strings
# (the compiler warns "String id 'AppName' undefined for language ..."). So each language also searches the tier
# folder; AppName is defined only there, never in resources/ or resources-<lang>/, so no language can override it.
base.lang.dan = $(base.lang.dan);resources-pro
base.lang.deu = $(base.lang.deu);resources-pro
base.lang.dut = $(base.lang.dut);resources-pro
base.lang.fin = $(base.lang.fin);resources-pro
base.lang.fre = $(base.lang.fre);resources-pro
base.lang.ita = $(base.lang.ita);resources-pro
base.lang.lit = $(base.lang.lit);resources-pro
base.lang.nob = $(base.lang.nob);resources-pro
base.lang.pol = $(base.lang.pol);resources-pro
base.lang.por = $(base.lang.por);resources-pro
base.lang.spa = $(base.lang.spa);resources-pro
base.lang.swe = $(base.lang.swe);resources-pro
base.lang.tur = $(base.lang.tur);resources-pro
base.lang.ukr = $(base.lang.ukr);resources-pro
