node_modules
dist
.ssr
.impeccable/review
# Per-session edit/finding cache of the design hook: absolute local paths and session ids, rewritten on every edit
.impeccable/hook.cache.json

# Local env files: Vite inlines anything VITE_*-prefixed into the client
# bundle, so a committed one ships its contents to every visitor.
.env
.env.*
!.env.example

# Firebase CLI: local cache/logs, and agent skills `firebase init` installs.
.firebase
*-debug.log
.agents
.claude
skills-lock.json
