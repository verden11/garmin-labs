# Pro build: the paid app, the live app id in manifest.xml (named "Days To Go Pro"). Excludes every (:free)-annotated
# symbol; docs/decisions.md ADR-014 (Free + Pro ladder). resources-pro holds what only Pro has: AppName and the full settings
# and properties (Hour, Footer). The shared resources/ has NO settings files, so two never overlap.
project.manifest = manifest.xml
base.sourcePath = source
base.resourcePath = resources;resources-pro;resources-accent-pro
base.excludeAnnotations = free;mono
# AppName is the one string that differs by tier, and a language does NOT inherit the default's strings
# (the compiler warns "String id 'AppName' undefined for language ..."). So each language also searches the tier
# folder; AppName is defined only there, never in resources/ or resources-<lang>/, so no language can override it.
base.lang.dan = $(base.lang.dan);resources-pro
base.lang.deu = $(base.lang.deu);resources-pro
base.lang.dut = $(base.lang.dut);resources-pro
base.lang.fin = $(base.lang.fin);resources-pro
base.lang.fre = $(base.lang.fre);resources-pro
base.lang.ita = $(base.lang.ita);resources-pro
base.lang.lit = $(base.lang.lit);resources-pro
base.lang.nob = $(base.lang.nob);resources-pro
base.lang.pol = $(base.lang.pol);resources-pro
base.lang.por = $(base.lang.por);resources-pro
base.lang.spa = $(base.lang.spa);resources-pro
base.lang.swe = $(base.lang.swe);resources-pro
base.lang.tur = $(base.lang.tur);resources-pro
base.lang.ukr = $(base.lang.ukr);resources-pro

# The Instinct family (ADR-015): black-and-white palette (`color` excluded), and no Accent settings file
# (resources-accent-<tier> is left out of their resourcePath: it has no effect on a 1-bit display). A per-product excludeAnnotations REPLACES the base list, so the tier's
# own exclude is restated.
instinct2.excludeAnnotations = free;color
instinct2.resourcePath = resources;resources-pro
instinct2s.excludeAnnotations = free;color
instinct2s.resourcePath = resources;resources-pro
instinct2x.excludeAnnotations = free;color
instinct2x.resourcePath = resources;resources-pro
descentg1.excludeAnnotations = free;color
descentg1.resourcePath = resources;resources-pro
instincte40mm.excludeAnnotations = free;color
instincte40mm.resourcePath = resources;resources-pro
instincte45mm.excludeAnnotations = free;color
instincte45mm.resourcePath = resources;resources-pro
instinct3solar45mm.excludeAnnotations = free;color
instinct3solar45mm.resourcePath = resources;resources-pro
