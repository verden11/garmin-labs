import Toybox.Lang;

// Where each row of the face sits (DaysToGoLayout.rows). A row that is absent
// keeps top 0 and is never drawn.
class DaysToGoRows {
    var timeTop as Number = 0;
    var nameTop as Number = 0;
    var heroTop as Number = 0;
    var heroHeight as Number = 0;
    var captionTop as Number = 0;
    var dateTop as Number = 0;
    var footerTop as Number = 0;
}
